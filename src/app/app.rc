// Icon and version information for both executables.
#include <winresrc.h>
#include "core/version.hpp"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GAO_VERSION_MAJOR, GAO_VERSION_MINOR, GAO_VERSION_PATCH, 0
 PRODUCTVERSION GAO_VERSION_MAJOR, GAO_VERSION_MINOR, GAO_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GPU Auto Optimizer"
            VALUE "FileVersion", GAO_VERSION_STRING
            VALUE "ProductName", "GPU Auto Optimizer"
            VALUE "ProductVersion", GAO_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 Rovey. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
